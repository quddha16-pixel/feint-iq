.gcloudignore
.git
.git/**
node_modules
node_modules/**
dist
dist/**
.env*
**/.env*
*.local
**/*.local
*.pem
**/*.pem
*.key
**/*.key
test-results
playwright-report
tests
**/*.test.ts
.github
docs
attachments
**/*.mp4
**/*.mov
**/*.webm
**/*.MP4
**/*.MOV
**/*.WEBM

# Short-lived google-github-actions/auth files must never be committed or uploaded.
gha-creds-*.json
**/gha-creds-*.json
**/__pycache__/

deploy/cloudrun/automation/test_*.py

.ruff_cache/
**/.ruff_cache/
*.tsbuildinfo
**/*.tsbuildinfo
