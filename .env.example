# Backend only. Copy to an ignored file such as .env.server after provider/hosting approval.
# Never prefix these secrets with VITE_ or put them in the GitHub Pages workflow.
GEMINI_API_KEY=
# Explicit provider opt-in. Blank preserves the existing Gemini behavior.
ANALYSIS_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=high
OPENAI_MAX_OUTPUT_TOKENS=16384
# Optional single-generation guard: token preflight + full output-cap cost.
# Use 4.50 for the one-attempt $5 pilot; not a cumulative account spending cap.
OPENAI_MAX_REQUEST_USD=4.50
ANALYSIS_ACCESS_TOKEN=
GEMINI_MODEL=gemini-3.5-flash-lite
FRONTEND_ORIGIN=https://quddha16-pixel.github.io
HOST=127.0.0.1
PORT=8787
