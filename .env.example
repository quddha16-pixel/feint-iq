# Backend only. Copy to an ignored file such as .env.server after provider/hosting approval.
# Never prefix these secrets with VITE_ or put them in the GitHub Pages workflow.
GEMINI_API_KEY=
ANALYSIS_ACCESS_TOKEN=
GEMINI_MODEL=gemini-3.5-flash-lite
FRONTEND_ORIGIN=https://quddha16-pixel.github.io
HOST=127.0.0.1
PORT=8787
# Optional backend limit (MiB); default and maximum are 25, below the Cloud Run HTTP/1 request ceiling.
# MAX_UPLOAD_MB=25
# PORT is injected by Cloud Run; do not configure it through Secret Manager or --set-env-vars.
